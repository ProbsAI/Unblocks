# =============================================================================
# Unblocks.ai — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# --- Required ---

# PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/unblocks

# Application URL (no trailing slash)
APP_URL=http://localhost:3000

# Database SSL mode — set to "disable" for local dev without SSL
# Production defaults to SSL enabled with certificate verification
# DATABASE_SSLMODE=disable

# Secret for signing JWTs and encrypting tokens (min 32 chars)
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# AES-256-GCM key for encrypting PII at rest (64-char hex = 32 bytes)
# Generate with: openssl rand -hex 32
# Key rotation: comma-separate keys (newest first), e.g. newkey,oldkey
ENCRYPTION_KEY=

# Stable HMAC key for blind index lookups (optional, 64-char hex = 32 bytes)
# Generate with: openssl rand -hex 32
# Set this BEFORE rotating ENCRYPTION_KEY to keep hash-based lookups working.
# If unset, blind index is derived from the primary ENCRYPTION_KEY.
# BLIND_INDEX_KEY=

# --- Redis (optional — for rate limiting + session cache) ---

REDIS_URL=redis://localhost:6379

# --- Stripe (required if billing enabled) ---

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email / Resend (required if email enabled) ---

RESEND_API_KEY=re_...

# --- Google OAuth (optional — leave blank to disable) ---

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Unblocks License (optional — controls footer attribution) ---

UNBLOCKS_LICENSE_KEY=

# Work factor for slowBlindIndex (PBKDF2-SHA256), used for enumerable values
# such as email. Defaults to OWASP's 600,000; values below 10,000 are ignored.
# Only affects signup / OAuth / magic-link paths, never per-request lookups.
BLIND_INDEX_ITERATIONS=

# --- AI (core/ai) ---
# At least one provider key is required for /api/ai/completion. Without one the
# endpoint fails with "No API key configured for provider: ...".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
